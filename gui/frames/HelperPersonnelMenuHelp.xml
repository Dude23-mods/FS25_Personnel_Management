<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="helperPersonnelMenuHelp">
    <GuiElement profile="fs25_menuContainer" name="helperPersonnelMenuHelp">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg"><Bitmap profile="fs25_menuHeaderIcon" imageSliceId="hpUiPm20260710c.help" /></Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_ui_pmMenuPageHelp" />
        </GuiElement>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px" />
        <!-- Native FS25 help navigation: the stock rounded tile reserves a
             compact icon column, populated by the mod's monochrome chapter icons. -->
        <GuiElement profile="fs25_subCategoryContainer" id="helpTopicsContainer">
            <GuiElement profile="fs25_subCategoryListContainer">
                <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper" />
                <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper" />
                <SmoothList profile="fs25_subCategoryList" id="helpTopicList" wrapAround="true"
                    focusInit="onOpen" startClipperElementName="startClipper"
                    endClipperElementName="endClipper" listSectionHeader="section">
                    <ListItem profile="fs25_subCategoryListItem">
                        <Bitmap profile="fs25_subCategoryListItemIconFull" name="icon" />
                        <Text profile="fs25_helpListItemName" name="title" />
                    </ListItem>
                    <ListItem profile="fs25_subCategoryListSectionHeader" name="section">
                        <Text profile="fs25_subCategoryListSectionHeaderTitle" name="title" />
                    </ListItem>
                </SmoothList>
                <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="helpTopicList" focusChangeTop="nil" />
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>
        <!-- Native FS25 article viewport, clippers and docked scrollbar. -->
        <GuiElement profile="fs25_menuContentContainer" id="helpArticleContainer" position="258px 40px">
            <GuiElement profile="fs25_helpLinelayoutBox">
                <Bitmap profile="fs25_helpLineStartClipper" name="topClipper" />
                <Bitmap profile="fs25_helpLineStopClipper" name="bottomClipper" />
                <ScrollingLayout profile="fs25_helpLinelayout" id="helpArticleLayout"
                    topClipperElementName="topClipper" bottomClipperElementName="bottomClipper">
                    <Text profile="fs25_helpLineItemTitle" id="helpArticleTitleTemplate" />
                    <BoxLayout profile="fs25_helpLineContentItem" id="helpArticleTextTemplate">
                        <Text profile="fs25_helpLineTextFullWith" name="textFullWidth" />
                    </BoxLayout>
                </ScrollingLayout>
            </GuiElement>
        </GuiElement>
        <ThreePartBitmap profile="fs25_sliderDockedBg" id="helpArticleSliderBackground">
            <ThreePartBitmap profile="fs25_sliderDockedBox">
                <Slider profile="fs25_helpLineSlider" id="helpArticleSlider" dataElementId="helpArticleLayout" />
            </ThreePartBitmap>
        </ThreePartBitmap>
    </GuiElement>
</GUI>
